# Ars Fleet Server env vars (copy to .env and adjust — never commit .env)
FLEET_HOST=0.0.0.0
FLEET_PORT=8550

# Admin auth
FLEET_ADMIN_USER=admin
FLEET_ADMIN_PASS=change-me
FLEET_JWT_SECRET=change-me-to-a-long-random-string

# Device pre-shared key (must match the SD provisioning FLEET_DEVICE_PSK)
FLEET_DEVICE_PSK=change-me

# Data dir (SQLite DB + uploaded media)
FLEET_DATA_DIR=./data

# Client advisory poll interval (seconds)
FLEET_POLL_INTERVAL=30

# Ops
FLEET_DISABLE_SHELL=1
FLEET_HEARTBEAT_KEEP=500
