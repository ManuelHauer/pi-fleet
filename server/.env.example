# Ars Fleet Server env vars (copy to .env and adjust)
FLEET_HOST=0.0.0.0
FLEET_PORT=8550

# Admin auth
FLEET_ADMIN_USER=admin
FLEET_ADMIN_PASS=change-me
FLEET_JWT_SECRET=change-me-to-a-long-random-string

# Device pre-shared key
FLEET_DEVICE_PSK=change-me

# Data dir
FLEET_DATA_DIR=/Users/computer/.openclaw/workspace/raspi-fleet/server/data

# Client advisory poll interval (seconds)
FLEET_POLL_INTERVAL=43200
