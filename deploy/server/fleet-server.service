[Unit]
Description=Ars Fleet Media Server (FastAPI)
After=network.target

[Service]
Type=simple
User=fleet
Group=fleet
WorkingDirectory=/opt/pi-fleet/server
EnvironmentFile=/etc/fleet-server/env
ExecStart=/opt/pi-fleet/server/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 8550
Restart=always
RestartSec=5

# Hardening
NoNewPrivileges=true
ProtectSystem=full
ReadWritePaths=/var/lib/fleet-server

[Install]
WantedBy=multi-user.target
