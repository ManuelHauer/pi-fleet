# Ars Fleet Server — deployment secrets (copy to .env, fill in, never commit)

# Public hostname for automatic HTTPS (Caddy) — DNS must point here
FLEET_DOMAIN=fleet.example.org

# Admin login for the dashboard/API
FLEET_ADMIN_USER=admin
FLEET_ADMIN_PASS=

# Long random string for session tokens (e.g. `openssl rand -hex 32`)
FLEET_JWT_SECRET=

# Pre-shared key the Pi devices authenticate with (also goes into the
# SD provisioning: FLEET_DEVICE_PSK for prepare_sd_card.sh)
FLEET_DEVICE_PSK=

# Remote shell command from the dashboard: 1 = disabled (recommended)
FLEET_DISABLE_SHELL=1
