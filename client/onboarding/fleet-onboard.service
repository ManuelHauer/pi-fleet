[Unit]
Description=Ars Festival Fleet Wi-Fi Onboarding
After=network.target NetworkManager.service
Wants=NetworkManager.service
ConditionPathExists=!/etc/fleet-client/onboard-done

[Service]
# Long-running (not oneshot): the captive portal waits for a technician for
# as long as it takes. Nothing orders itself after this unit — the player,
# USB/SD kiosk paths and local control all work while onboarding is pending.
# onboard-done is written by onboard_service.py itself on success.
Type=simple
ExecStart=/usr/bin/python3 /opt/fleet-client/onboarding/onboard_service.py
Restart=on-failure
RestartSec=30
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
