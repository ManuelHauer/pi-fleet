[Unit]
Description=Ars Festival Fleet Client (management daemon)
After=network.target fleet-player.service
Wants=fleet-player.service
StartLimitIntervalSec=600
StartLimitBurst=10

[Service]
Type=simple
User=pi
ExecStart=/usr/bin/python3 /opt/fleet-client/fleet_client.py
Restart=always
RestartSec=15
WatchdogSec=60
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
