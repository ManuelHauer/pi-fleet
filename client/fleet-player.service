[Unit]
Description=Ars Festival Fleet Player (mpv)
After=multi-user.target
StartLimitIntervalSec=600
StartLimitBurst=20

[Service]
Type=simple
User=pi
SupplementaryGroups=video render audio input tty
ExecStart=/usr/bin/python3 /opt/fleet-client/fleet_player.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
